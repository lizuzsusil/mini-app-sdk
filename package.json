{
  "name": "@lizuz/sewa-sdk",
  "version": "1.0.8",
  "description": "Framework-agnostic Mini App SDK for vendor mini apps. Event-based communication with the host shell.",
  "main": "./dist/sewa-sdk.js",
  "module": "./dist/sewa-sdk.mjs",
  "browser": "./dist/sewa-sdk.min.js",
  "unpkg": "./dist/sewa-sdk.min.js",
  "jsdelivr": "./dist/sewa-sdk.min.js",
  "exports": {
    ".": {
      "browser": "./dist/sewa-sdk.min.js",
      "import": "./dist/sewa-sdk.mjs",
      "require": "./dist/sewa-sdk.js"
    },
    "./device": {
      "import": "./dist/device.mjs",
      "require": "./dist/device.js"
    },
    "./http": {
      "import": "./dist/http.mjs",
      "require": "./dist/http.js"
    },
    "./storage": {
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "prebuild": "npm run generate:version",
    "pretest": "npm run generate:version",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsup src/index.ts --format cjs,esm --clean --sourcemap && node scripts/rename-lib.mjs",
    "build:cdn": "esbuild src/cdn.ts --bundle --format=iife --platform=browser --target=es2020 --minify --sourcemap --outfile=dist/sewa-sdk.min.js",
    "build": "biome check --error-on-warnings --max-diagnostics=200 . && npm run build:lib && npm run build:cdn && npm run size:check",
    "size:check": "node scripts/check-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint:fix": "npm run lint && npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@lizuz/mini-app-types": "^1.1.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
