{
  "name": "sewa-sdk",
  "version": "1.0.0-beta",
  "description": "Framework-agnostic Mini App SDK for vendor mini apps. Event-based communication with the host shell.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/sewa-sdk.min.js",
  "unpkg": "./dist/sewa-sdk.min.js",
  "jsdelivr": "./dist/sewa-sdk.min.js",
  "exports": {
    ".": {
      "browser": "./dist/sewa-sdk.min.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:lib": "tsup src/index.ts src/testing/index.ts --format cjs,esm --dts --clean",
    "build:cdn": "esbuild src/cdn.ts --bundle --format=iife --platform=browser --target=es2020 --minify --outfile=dist/sewa-sdk.min.js",
    "build": "npm run build:lib && npm run build:cdn",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
